me. Use appointment_id from list_upcoming_appointments and new_slot_id from check_schedule when available. Confirm the new date and time with the caller before rescheduling."},"orgId":"69bcf4c3-93f2-441e-9ff3-d774b027bca6","server":{"url":"https://twice-stakeholders-choice-parallel.trycloudflare.com/api/webhooks/vapi","secret":"LoaraSecretKey2026","headers":{"Bypass-Tunnel-Reminder":"Over 9 levels deep, aborting normalization","ngrok-skip-browser-warning":"Over 9 levels deep, aborting normalization"},"timeoutSeconds":20},"latestVersion":"v3"},{"id":"82c778df-c57d-400b-8961-5f156dd92eb7","createdAt":"2026-08-31T19:59:33.710Z","updatedAt":"2026-09-02T11:24:30.204Z","type":"function","function":{"name":"cancel_appointment","parameters":{"type":"Over 9 levels deep, aborting normalization","properties":"Over 9 levels deep, aborting normalization"},"description":"Cancel an existing upcoming appointment. Use appointment_id from list_upcoming_appointments when available. Confirm the cancellation with the caller before proceeding."},"orgId":"69bcf4c3-93f2-441e-9ff3-d774b027bca6","server":{"url":"https://twice-stakeholders-choice-parallel.trycloudflare.com/api/webhooks/vapi","secret":"LoaraSecretKey2026","headers":{"Bypass-Tunnel-Reminder":"Over 9 levels deep, aborting normalization","ngrok-skip-browser-warning":"Over 9 levels deep, aborting normalization"},"timeoutSeconds":20},"latestVersion":"v3"},{"id":"15bc2d5b-865f-4bc3-b6de-a9a6c9ee3f7c","createdAt":"2026-08-31T19:59:34.046Z","updatedAt":"2026-09-02T11:24:30.530Z","type":"function","function":{"name":"verify_insurance","parameters":{"type":"Over 9 levels deep, aborting normalization","required":"Over 9 levels deep, aborting normalization","properties":"Over 9 levels deep, aborting normalization"},"description":"Verify a patient insurance eligibility and coverage details."},"orgId":"69bcf4c3-93f2-441e-9ff3-d774b027bca6","server":{"url":"https://twice-stakeholders-choice-parallel.trycloudflare.com/api/webhooks/vapi","secr